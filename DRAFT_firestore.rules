rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'quantity', 'userId', 'iconType', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.quantity is string && data.quantity.size() > 0 && data.quantity.size() <= 50 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.iconType is string && data.iconType.size() <= 50;
    }

    match /users/{userId}/inventory/{itemId} {
      allow read, list: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(userId) && userId == request.auth.uid
                    && isValidId(itemId) 
                    && isValidInventoryItem(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn() 
                    && isValidId(userId) && userId == request.auth.uid
                    && isValidId(itemId)
                    && isValidInventoryItem(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'quantity', 'iconType', 'updatedAt'])
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }
  }
}
