rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'quantity', 'unit', 'iconType', 'userId', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             (data.quantity is number || data.quantity is string) &&
             data.unit is string && data.unit.size() <= 50 &&
             data.iconType is string && data.iconType.size() <= 50 &&
             data.userId is string && data.userId == request.auth.uid &&
             (!data.keys().hasAll(['price']) || (data.price is number || data.price == null));
    }

    function isValidRecipe(data) {
      return data.keys().hasAll(['name', 'ingredients', 'createdAt', 'userId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.ingredients is list && data.ingredients.size() <= 50 &&
             data.userId is string && data.userId == request.auth.uid;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['clientName', 'productName', 'recipeId', 'quantity', 'userId', 'createdAt']) &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 150 &&
             data.productName is string && data.productName.size() > 0 && data.productName.size() <= 150 &&
             data.recipeId is string &&
             data.quantity is number &&
             data.userId is string && data.userId == request.auth.uid;
    }

    match /users/{userId}/inventory/{itemId} {
      allow read, list: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(userId) && userId == request.auth.uid
                    && isValidId(itemId) 
                    && isValidInventoryItem(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn() 
                    && isValidId(userId) && userId == request.auth.uid
                    && isValidId(itemId)
                    && isValidInventoryItem(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'quantity', 'unit', 'iconType', 'price', 'updatedAt'])
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }

    match /users/{userId}/recipes/{recipeId} {
      allow read, list: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(userId) && userId == request.auth.uid
                    && isValidId(recipeId)
                    && isValidRecipe(incoming())
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn()
                    && isValidId(userId) && userId == request.auth.uid
                    && isValidId(recipeId)
                    && isValidRecipe(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'ingredients'])
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }

    match /users/{userId}/sales/{saleId} {
      allow read, list: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(userId) && userId == request.auth.uid
                    && isValidId(saleId)
                    && isValidSale(incoming())
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn()
                    && isValidId(userId) && userId == request.auth.uid
                    && isValidId(saleId)
                    && isValidSale(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['clientName', 'productName', 'recipeId', 'quantity'])
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }
  }
}
